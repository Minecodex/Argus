{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.io/schemas/v1/agent/tool-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "title",
    "description",
    "keywords",
    "result_description",
    "preconditions",
    "examples",
    "category",
    "name",
    "version",
    "discovery_hash",
    "risk",
    "required_permissions",
    "input_schema",
    "requires_confirmation"
  ],
  "properties": {
    "schema_version": {
      "const": "argus.tool_manifest/v1"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "\\S"
      }
    },
    "result_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "\\S"
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "guidance"
        ],
        "properties": {
          "request": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "guidance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          }
        }
      }
    },
    "category": {
      "enum": [
        "host",
        "k8s",
        "metric",
        "trace",
        "log",
        "connector",
        "workflow"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "discovery_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "risk": {
      "type": "string",
      "minLength": 1
    },
    "required_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "requires_confirmation": {
      "type": "boolean"
    }
  }
}
