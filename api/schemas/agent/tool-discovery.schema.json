{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.io/schemas/v1/agent/tool-discovery.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "title",
    "description",
    "keywords",
    "result_description",
    "preconditions",
    "examples"
  ],
  "properties": {
    "schema_version": {
      "const": "argus.tool_discovery/v1"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "\\S"
      }
    },
    "result_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "\\S"
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "guidance"
        ],
        "properties": {
          "request": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "guidance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          }
        }
      }
    },
    "resource_types": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "host",
          "kubernetes_cluster",
          "kubernetes_namespace",
          "application",
          "monitoring_target",
          "dashboard",
          "connector",
          "alert"
        ]
      }
    },
    "signals": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "metrics",
          "logs",
          "traces"
        ]
      }
    },
    "operation_kind": {
      "type": "string",
      "enum": [
        "discover",
        "query",
        "prepare",
        "preview",
        "control",
        "deliver"
      ]
    },
    "result_kind": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "resource_detail",
          "resource_list",
          "pending_action",
          "operation_status",
          "file",
          "interaction",
          "dashboard_draft",
          "timeseries",
          "instant_vector",
          "scalar",
          "logs",
          "table",
          "traces",
          "apm",
          "coverage",
          "dashboard_result",
          "metric_catalog",
          "fields",
          "values",
          "resource_capabilities"
        ]
      }
    }
  }
}
